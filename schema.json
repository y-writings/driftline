{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/y-writings/driftline/main/schema.json",
  "title": "driftline Source Manifest",
  "description": "Schema for .driftline-source.yaml in a Source Repository. Target paths are configured by Target Repositories, not in this manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files"],
  "properties": {
    "version": {
      "description": "Source manifest schema version.",
      "const": 2
    },
    "gitignore": {
      "description": "Entries driftline appends to the Target Repository .gitignore.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "description": "Files made available by the Source Repository.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths"],
      "properties": {
        "id": {
          "description": "Stable adoption unit identifier used by Target Config entries.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "description": "Human-readable adoption unit name.",
          "type": "string"
        },
        "paths": {
          "description": "Source files included in this adoption unit, keyed by stable file identifier.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sourcePath"
          }
        }
      }
    },
    "sourcePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "name": {
          "description": "Human-readable source file name.",
          "type": "string"
        },
        "path": {
          "description": "Relative source repository path.",
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!\\.$)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*/$).+$"
    }
  }
}
